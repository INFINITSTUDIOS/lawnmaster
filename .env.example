# Root domain the platform runs on (no protocol). Storefronts live at {slug}.<root>.
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (platform account with Connect enabled)
STRIPE_SECRET_KEY=
# Signing secret of a *Connect* webhook endpoint pointing at /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# Mapbox public token
NEXT_PUBLIC_MAPBOX_TOKEN=

# Vercel (custom domains). Optional: without these, domains are saved but not provisioned.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Bearer secret for /api/cron/generate-visits (Vercel Cron sends it automatically)
CRON_SECRET=
